<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.mako.support</id>
    <name>Mako</name>
    <vendor email="zarinpy@gmail.com">omid zarinmahd</vendor>
    <description><![CDATA[
        <p>Editor support for the <a href="https://www.makotemplates.org/">Mako</a> template language.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends>com.intellij.modules.python</depends>
    <!-- Template-language classes load only when the professional Python plugin is present. -->
    <depends optional="true" config-file="mako-python-pro.xml">Pythonid</depends>

    <extensionPoints>
        <extensionPoint name="renderContext" interface="com.mako.support.run.MakoRenderContext"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Mako"
            implementationClass="com.mako.support.lang.MakoFileType"
            fieldName="INSTANCE"
            language="Mako"
            extensions="mako;mak"/>
        <lang.parserDefinition
            language="Mako"
            implementationClass="com.mako.support.parser.MakoParserDefinition"/>
        <lang.fileViewProviderFactory
            language="Mako"
            implementationClass="com.mako.support.template.MakoFileViewProviderFactory"/>
        <lang.syntaxHighlighterFactory
            language="Mako"
            implementationClass="com.mako.support.highlight.MakoSyntaxHighlighterFactory"/>
        <editorHighlighterProvider
            filetype="Mako"
            implementationClass="com.mako.support.highlight.MakoEditorHighlighterProvider"/>
        <spellchecker.support
            language="Mako"
            implementationClass="com.mako.support.spellcheck.MakoSpellcheckingStrategy"/>
        <multiHostInjector implementation="com.mako.support.inject.MakoPythonInjector"/>
        <completion.contributor language="Mako" implementationClass="com.mako.support.edit.MakoCompletionContributor"/>
        <completion.contributor language="Python" implementationClass="com.mako.support.edit.MakoTagPrefixContributor" order="first"/>
        <typedHandler implementation="com.mako.support.edit.MakoTypedHandler"/>
        <enterHandlerDelegate implementation="com.mako.support.edit.MakoEnterHandler"/>
        <lang.foldingBuilder language="Mako" implementationClass="com.mako.support.edit.MakoFoldingBuilder"/>
        <lang.psiStructureViewFactory language="Mako" implementationClass="com.mako.support.edit.MakoStructureViewFactory"/>
        <breadcrumbsInfoProvider implementation="com.mako.support.edit.MakoBreadcrumbsProvider"/>
        <liveTemplateContext contextId="Mako" implementation="com.mako.support.edit.MakoTemplateContext"/>
        <defaultLiveTemplatesProvider implementation="com.mako.support.edit.MakoLiveTemplatesProvider"/>
        <lang.surroundDescriptor language="Mako" implementationClass="com.mako.support.edit.MakoSurroundDescriptor"/>
        <lang.formatter language="Mako" implementationClass="com.mako.support.edit.MakoFormattingModelBuilder"/>
        <codeInsight.lineMarkerProvider language="Mako" implementationClass="com.mako.support.edit.MakoLineMarkerProvider"/>
        <projectService serviceImplementation="com.mako.support.run.MakoProjectSettings"/>
        <projectService serviceImplementation="com.mako.support.run.MakoPreviewSession"/>
        <consoleFilterProvider implementation="com.mako.support.run.MakoTracebackFilterProvider"/>
        <toolWindow id="Mako Preview" anchor="bottom" factoryClass="com.mako.support.run.MakoPreviewToolWindowFactory" doNotActivateOnStart="true"/>
    </extensions>

    <actions>
        <action id="Mako.Preview" class="com.mako.support.run.MakoPreviewAction" text="Mako: Preview Template"
                description="Render the current Mako template with the project interpreter">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
