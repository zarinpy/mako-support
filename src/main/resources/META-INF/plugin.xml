<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.mako.support</id>
    <name>Mako</name>
    <vendor email="zarinpy@gmail.com">omid zarinmahd</vendor>
    <description><![CDATA[
        <p>Editor support for the <a href="https://www.makotemplates.org/">Mako</a> template language.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends>com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Mako"
            implementationClass="com.mako.support.lang.MakoFileType"
            fieldName="INSTANCE"
            language="Mako"
            extensions="mako;mak"/>
        <lang.parserDefinition
            language="Mako"
            implementationClass="com.mako.support.parser.MakoParserDefinition"/>
        <lang.fileViewProviderFactory
            language="Mako"
            implementationClass="com.mako.support.template.MakoFileViewProviderFactory"/>
        <lang.syntaxHighlighterFactory
            language="Mako"
            implementationClass="com.mako.support.highlight.MakoSyntaxHighlighterFactory"/>
        <editorHighlighterProvider
            filetype="Mako"
            implementationClass="com.mako.support.highlight.MakoEditorHighlighterProvider"/>
        <spellchecker.support
            language="Mako"
            implementationClass="com.mako.support.spellcheck.MakoSpellcheckingStrategy"/>
        <multiHostInjector implementation="com.mako.support.inject.MakoPythonInjector"/>
        <applicationInitializedListener
            implementation="com.mako.support.inject.MakoPythonTestLayout"/>
    </extensions>
</idea-plugin>
